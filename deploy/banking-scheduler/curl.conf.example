# Install as /etc/budget-tracker-banking/curl.conf, root:root, mode 0600.
# This is a template. Replace both placeholders on the server before enabling.
# Escape a double quote or backslash inside a quoted value with a backslash.
url = "https://REPLACE_KOYEB_HOST/banking/jobs/sync"
request = "POST"
header = "Content-Type: application/json"
header = "Authorization: Bearer REPLACE_BANK_SYNC_CRON_SECRET"
data = "{}"
