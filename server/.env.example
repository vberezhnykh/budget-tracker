# Copy this file to server/.env and fill in real values. Never commit .env.

# MongoDB connection string. Read-write - used by the app itself and by
# server/restore.js.
MONGODB_URI=

# Optional, read-only connection string used by server/backup.js (and by
# anything else that only needs to read the data, e.g. an assistant or a
# scheduled job). Point this at a dedicated MongoDB user granted only the
# `read` role on this database, so write access is refused by the database
# itself rather than by application code:
#
#   db.getSiblingDB('admin').createUser({
#     user: 'backup',
#     pwd: '<длинный случайный пароль>',
#     roles: [{ role: 'read', db: '<имя базы>' }]
#   })
#
# On Atlas the same thing is done in Database Access - add a user with the
# built-in "Only read any database" role (or a custom role scoped to this
# database), then paste its connection string here.
#
# If left unset, server/backup.js falls back to MONGODB_URI and warns that
# it is using a credential that can also write.
MONGODB_BACKUP_URI=

# Port the Express server listens on (optional, defaults to 5000).
PORT=

# Set to "production" when running the built app for real (enables secure
# cookies, static asset serving, etc.). Leave unset for local development.
NODE_ENV=

# Public URL of the deployed instance (used for CORS allow-listing and to
# keep a Render free-tier instance from sleeping). Not needed locally.
RENDER_EXTERNAL_URL=

# --- Authentication (shared family password) ---
# The single password checked by POST /api/login. Pick something long and
# random enough to resist guessing - this guards the whole API. Must be at
# least 8 characters (and not whitespace-only) or it is treated as unset.
# The login rate limiter (see server/auth.js) backstops brute-forcing this.
APP_PASSWORD=

# Secret key used to HMAC-sign the session cookie (crypto.createHmac
# 'sha256'). Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters (and not whitespace-only) or it is treated
# as unset.
SESSION_SECRET=

# If either APP_PASSWORD or SESSION_SECRET is missing, empty, whitespace-only,
# or too short: every /api/* request (login included) returns 503, and the
# server logs a startup error naming the specific variable(s) that are
# missing vs. too weak (never the values themselves) - in every environment,
# regardless of NODE_ENV. There is no NODE_ENV-based fail-open anymore.

# WARNING - local development only, never set this on a deployment reachable
# from outside your own machine:
# Set to exactly "true" to allow requests through anyway while
# APP_PASSWORD/SESSION_SECRET are unset, so local work without a configured
# .env isn't blocked. Even then, this only bypasses auth for requests whose
# source IP is loopback (127.0.0.1 / ::1) - a remote caller is still
# rejected with 503 no matter what this is set to. Leave unset everywhere
# else.
AUTH_DISABLED=
