# Copy this file to server/.env and fill in real values. Never commit .env.

# MongoDB connection string.
MONGODB_URI=

# Port the Express server listens on (optional, defaults to 5000).
PORT=

# Set to "production" when running the built app for real (enables secure
# cookies, static asset serving, etc.). Leave unset for local development.
NODE_ENV=

# Public URL of the deployed instance (used for CORS allow-listing and to
# keep a Render free-tier instance from sleeping). Not needed locally.
RENDER_EXTERNAL_URL=

# --- Authentication (shared family password) ---
# The single password checked by POST /api/login. Pick something long and
# random enough to resist guessing - this guards the whole API.
APP_PASSWORD=

# Secret key used to HMAC-sign the session cookie (crypto.createHmac
# 'sha256'). Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# If either APP_PASSWORD or SESSION_SECRET is missing:
#   - in production, every /api/* request (login included) returns 503 and
#     the server logs a startup error naming the missing variable(s).
#   - in development, a warning is logged and requests are allowed through
#     unauthenticated, so local work without a configured .env isn't blocked.
